# ──────────────────────────────────────────────────
# GitWise — Environment Variables
# ──────────────────────────────────────────────────

# REQUIRED: Groq API Key
# Get it FREE at: https://console.groq.com/keys
# ✅ Llama 3 models — blazing fast with a generous free tier
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: GitHub Personal Access Token
# Increases clone rate limits from 60 to 5,000 req/hour
# Get it at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# ──────────────────────────────────────────────────
# Optional overrides (defaults shown)
# ──────────────────────────────────────────────────

# PORT=8001
# CHAT_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=models/embedding-001
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K_RETRIEVAL=8
